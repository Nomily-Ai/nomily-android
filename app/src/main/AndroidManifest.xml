<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE scanning / connection. API 31+ uses new permissions; neverForLocation indicates we do not use Bluetooth for location,
         so on 31+ we don't need ACCESS_FINE_LOCATION. On 30 and below, the old permissions + location permission are still required. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- ⚠️ This **cannot** be capped with maxSdkVersion=30 any more.
         It was originally only a fallback for BLE scanning on API ≤30, so it was capped; however fast transfer needs
         WifiNetworkSpecifier, and **on Android 12 without location permission the target hotspot cannot be discovered** ——
         the symptom is a system dialog constantly showing "searching", which eventually times out and the app withdraws,
         the user sees "the app has cancelled the request to select a device", easily mistaken for the hotspot not existing.
         On 33+ we switch to NEARBY_WIFI_DEVICES (with neverForLocation, indicating we do not use it for location). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- ASR/LLM uses HTTP; fast transfer must request a Wi‑Fi network dedicated to this process.
         **INTERNET was previously omitted** — without it any HTTP call throws a SecurityException. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WifiManager.isWifiEnabled requires this; missing it throws a SecurityException directly (experienced). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- The local ASR server is **a user‑provided HTTP host** (`http://<host>:<port+1>/v1/transcribe`),
         cleartext traffic is disabled by default starting Android 9; without this permission the "local ASR" provider never works ——
         on real devices the error is `Cleartext HTTP traffic to <host> not permitted` (reproduced 2026-08-04). -->
    <!-- Foreground Service during real‑time transcription.
         Audio comes from a BLE device and the app never records the phone mic, so the type is `connectedDevice`; notification permission is needed only on API 33+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nomily">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nomily"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported M4A files are shared with other apps via ACTION_SEND; only the cache/exports/ directory is exposed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name=".LiveSessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
